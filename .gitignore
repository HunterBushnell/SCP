logs/old/
# logs/status/
archive/

# Generated simulation outputs are ignored by default. Keep only curated public
# example outputs tracked.
cells/**/output_data/*
!cells/SST/tunes/tuned/output_data/
!cells/SST/tunes/tuned/output_data/SST5_base/
!cells/SST/tunes/tuned/output_data/SST5_base/**
!cells/SST/tunes/tuned/output_data/SST5_tuned/
!cells/SST/tunes/tuned/output_data/SST5_tuned/**

!cells/PV/tunes/tuned/output_data/
!cells/PV/tunes/tuned/output_data/PV5_base/
!cells/PV/tunes/tuned/output_data/PV5_base/**
!cells/PV/tunes/tuned/output_data/PV5_tuned/
!cells/PV/tunes/tuned/output_data/PV5_tuned/**

# Large per-trial input-stat sidecars are regenerated locally and omitted from
# public example outputs.
cells/**/output_data/**/input_stats.json

cells/**/output_data/**/logs/*
cells/**/notebook_exports/
cells/**/tuning_exports/
cells/**/restore_backups/
cells/**/*.nwb
cells/**/act_workspace/

# Project workspaces follow the same source/config visibility policy as cells/.
# Keep native models and configs eligible for Git; ignore generated products.
projects/*/cells/**/output_data/*
projects/*/cells/**/notebook_exports/
projects/*/cells/**/tuning_exports/
projects/*/cells/**/restore_backups/
projects/*/cells/**/*.nwb
projects/*/cells/**/act_workspace/

# Local scratch morphology/browser exports.
cells/*/tunes*.svg
cells/*/tunes/*.svg
external_data/*.pkl
external_data/*.pickle
external_data/*.npy
external_data/*.npz
external_data/*.xlsx
external_data/*.xls

# Python cache/build artifacts
*.egg-info/
build/
dist/
__pycache__/
.scp_build/
*.py[cod]
*.pyo

# OS/editor artifacts
.DS_Store

# Jupyter
.ipynb_checkpoints/

# NEURON compiled artifacts (build as needed per tune)
cells/**/x86_64/
cells/**/modfiles/x86_64/
projects/*/cells/**/x86_64/
projects/*/cells/**/aarch64/

# Local release checklist
PUBLIC_RELEASE_TODO.local.md

# Checkout-local notebook navigation/preferences are not public example defaults.
# Project-owned repositories may track their own settings independently.
/.scp_project.json
/.scp_pipeline_settings.json
